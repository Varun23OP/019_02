# KisanSetu Community-Owned Credit Network — Environment Configuration

# Application Settings
APP_NAME=KisanSetu Financial Infrastructure API
APP_VERSION=2.0.0
DEBUG=False

# Database Settings
# SQLite for local development: sqlite:///./farmer_finance.db
# PostgreSQL for production: postgresql://user:password@localhost:5432/kisansetu_db
DATABASE_URL=sqlite:///./farmer_finance.db

# Security
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost:8501", "*"]

# API Prefix
API_V1_PREFIX=/api/v1

# Agricultural Data Integrations (Optional Production Overrides)
# Set to 'live' if private government credentials are provided; defaults to curated APMC feeds
AGMARKNET_DATA_MODE=VERIFIED_APMC_FEED
PMFBY_REGISTRY_MODE=NATIONAL_PORTAL_MOCK_FALLBACK

# Voice & ASR Engine Configuration
VOICE_ASR_ENGINE=Conformer-Multilingual-ASR
VOICE_MAX_FILE_SIZE_MB=15
