# KisanSetu Environment Variables & Credentials Example

# OpenAI API Key for Whisper Speech-to-Text & OpenAI TTS (Optional)
# If not provided, KisanSetu automatically uses Google Speech Recognition and gTTS (Free/Offline capable)
OPENAI_API_KEY=your_openai_api_key_here

# Speech-to-Text Provider (whisper / google / browser)
STT_PROVIDER=google

# Text-to-Speech Provider (gtts / openai / browser)
TTS_PROVIDER=gtts

# AGMARKNET 2.0 Mandi Rates API Key (Optional live OGD token)
AGMARKNET_API_KEY=

# Open-Meteo Weather Service URL
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Fast API Backend Port
PORT=8000
